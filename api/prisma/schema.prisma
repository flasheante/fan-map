generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String      @id @default(uuid())
  email      String      @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  fanProfile FanProfile?
  sessions   Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Country {
  id     String @id @default(uuid())
  name   String
  code   String @unique
  cities City[]

  @@map("countries")
}

model City {
  id          String       @id @default(uuid())
  name        String
  countryId   String
  latitude    Float?
  longitude   Float?
  country     Country      @relation(fields: [countryId], references: [id])
  fanProfiles FanProfile[]
  shows       Show[]

  @@unique([countryId, name])
  @@index([countryId])
  @@map("cities")
}

model Artist {
  id        String      @id @default(uuid())
  name      String
  slug      String      @unique
  imageUrl  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  fans      FanArtist[]
  shows     Show[]
  songs     Song[]

  @@map("artists")
}

model FanProfile {
  id          String      @id @default(uuid())
  userId      String      @unique
  cityId      String
  displayName String
  showOnMap   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  artists     FanArtist[]
  city        City        @relation(fields: [cityId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@index([showOnMap])
  @@index([cityId])
  @@map("fan_profiles")
}

model FanArtist {
  fanProfileId String
  artistId     String
  createdAt    DateTime   @default(now())
  artist       Artist     @relation(fields: [artistId], references: [id])
  fanProfile   FanProfile @relation(fields: [fanProfileId], references: [id])

  @@id([fanProfileId, artistId])
  @@index([artistId])
  @@map("fan_artists")
}

model Show {
  id         String   @id @default(uuid())
  artistId   String
  cityId     String
  date       DateTime
  venue      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  externalId String?  @unique
  setlist    Setlist?
  artist     Artist   @relation(fields: [artistId], references: [id])
  city       City     @relation(fields: [cityId], references: [id])

  @@index([artistId])
  @@index([cityId])
  @@map("shows")
}

model Setlist {
  id        String        @id @default(uuid())
  showId    String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  songs     SetlistSong[]
  show      Show          @relation(fields: [showId], references: [id])

  @@map("setlists")
}

model SetlistSong {
  id        String  @id @default(uuid())
  setlistId String
  title     String
  position  Int
  setlist   Setlist @relation(fields: [setlistId], references: [id])

  @@unique([setlistId, position])
  @@index([setlistId])
  @@map("setlist_songs")
}

// Catálogo canónico de canciones de un artista (estudio + EPs + singles),
// sincronizado desde MusicBrainz — ver
// src/integrations/musicbrainz y src/songs/musicbrainz-sync.service.ts.
// Deliberadamente distinto de SetlistSong: SetlistSong es una fila por
// canción tocada en un show puntual (puede repetirse show tras show);
// Song es una fila por grabación real de MusicBrainz, una sola vez, para
// que a futuro los fans puedan armar setlists eligiendo de acá.
model Song {
  id          String    @id @default(uuid())
  artistId    String
  title       String
  albumTitle  String?
  releaseDate DateTime?
  mbid        String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  artist      Artist    @relation(fields: [artistId], references: [id])

  @@index([artistId])
  @@map("songs")
}
