generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String      @id @default(uuid())
  email          String      @unique
  // Foto de perfil heredada del ID token de Google (claim `picture`) — ver
  // GoogleOAuthClient#getIdentity y AuthService#findOrCreateFromGoogle.
  // Nunca un archivo propio: solo la URL que Google ya aloja. Nullable
  // porque Google no siempre la entrega. Vive en User (identidad), no en
  // FanProfile: aunque hoy la relación sea 1:1, es un dato de la cuenta,
  // no del perfil de fan.
  googlePhotoUrl String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  fanProfile     FanProfile?
  sessions       Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Country {
  id     String @id @default(uuid())
  name   String
  code   String @unique
  cities City[]

  @@map("countries")
}

model City {
  id          String       @id @default(uuid())
  name        String
  countryId   String
  latitude    Float?
  longitude   Float?
  country     Country      @relation(fields: [countryId], references: [id])
  fanProfiles FanProfile[]
  shows       Show[]

  @@unique([countryId, name])
  @@index([countryId])
  @@map("cities")
}

model Artist {
  id               String      @id @default(uuid())
  name             String
  slug             String      @unique
  imageUrl         String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  // Última vez que SetlistFmSyncService.syncTheWarning() terminó una
  // corrida completa sin tirar (ver setlist-fm-sync.service.ts) — null
  // hasta la primera corrida exitosa. A propósito no es "la última vez que
  // algo cambió": persistShow hace upsert de todos los shows en cada
  // corrida aunque no haya nada nuevo en setlist.fm, así que esto refleja
  // cuándo se chequeó, no cuándo hubo un cambio real.
  setlistsSyncedAt DateTime?
  fans             FanArtist[]
  shows            Show[]
  songs            Song[]

  @@map("artists")
}

model FanProfile {
  id                String                   @id @default(uuid())
  userId            String                   @unique
  cityId            String
  displayName       String
  showOnMap         Boolean                  @default(false)
  // 5 redes fijas, cada una con su propio par url/isPublic — a propósito,
  // no una tabla genérica de "social links": son 5 plataformas conocidas y
  // fijas, no un catálogo abierto (ver fan-profiles.service.ts). Cargar
  // una URL nunca la hace pública por sí sola: isPublic siempre arranca en
  // false y el usuario lo activa explícitamente.
  instagramUrl      String?
  instagramIsPublic Boolean                  @default(false)
  tiktokUrl         String?
  tiktokIsPublic    Boolean                  @default(false)
  xUrl              String?
  xIsPublic         Boolean                  @default(false)
  youtubeUrl        String?
  youtubeIsPublic   Boolean                  @default(false)
  facebookUrl       String?
  facebookIsPublic  Boolean                  @default(false)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  artists           FanArtist[]
  setlistSongs      FanProfileSetlistSong[]
  favoriteSongs     FanProfileFavoriteSong[]
  city              City                     @relation(fields: [cityId], references: [id])
  user              User                     @relation(fields: [userId], references: [id])

  @@index([showOnMap])
  @@index([cityId])
  @@map("fan_profiles")
}

model FanArtist {
  fanProfileId String
  artistId     String
  createdAt    DateTime   @default(now())
  artist       Artist     @relation(fields: [artistId], references: [id])
  fanProfile   FanProfile @relation(fields: [fanProfileId], references: [id])

  @@id([fanProfileId, artistId])
  @@index([artistId])
  @@map("fan_artists")
}

model Show {
  id         String   @id @default(uuid())
  artistId   String
  cityId     String
  date       DateTime
  venue      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  externalId String?  @unique
  setlist    Setlist?
  artist     Artist   @relation(fields: [artistId], references: [id])
  city       City     @relation(fields: [cityId], references: [id])

  @@index([artistId])
  @@index([cityId])
  @@map("shows")
}

model Setlist {
  id        String        @id @default(uuid())
  showId    String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  songs     SetlistSong[]
  show      Show          @relation(fields: [showId], references: [id])

  @@map("setlists")
}

model SetlistSong {
  id        String  @id @default(uuid())
  setlistId String
  title     String
  position  Int
  setlist   Setlist @relation(fields: [setlistId], references: [id])

  @@unique([setlistId, position])
  @@index([setlistId])
  @@map("setlist_songs")
}

// Catálogo canónico de canciones de un artista (estudio + EPs + singles),
// sincronizado desde MusicBrainz — ver
// src/integrations/musicbrainz y src/songs/musicbrainz-sync.service.ts.
// Deliberadamente distinto de SetlistSong: SetlistSong es una fila por
// canción tocada en un show puntual (puede repetirse show tras show);
// Song es una fila por grabación real de MusicBrainz, una sola vez, para
// que a futuro los fans puedan armar setlists eligiendo de acá.
model Song {
  id          String                   @id @default(uuid())
  artistId    String
  title       String
  albumTitle  String?
  releaseDate DateTime?
  mbid        String                   @unique
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  artist      Artist                   @relation(fields: [artistId], references: [id])
  setlistedBy FanProfileSetlistSong[]
  favoritedBy FanProfileFavoriteSong[]

  @@index([artistId])
  @@map("songs")
}

// Etapa "Setlist + Top 10 independientes": reemplaza al viejo
// FanProfileSong (favoritas y Top10 en una sola tabla, unidas por un
// topPosition nullable). Ahora son dos tablas separadas, sin relación
// obligatoria entre sí — una canción puede estar en ninguna, una o ambas
// listas de un mismo fan, de forma completamente independiente.
//
// El setlist personal de un fan (hasta 15 canciones, validado en la
// aplicación — ver FanProfilesService, no acá): a diferencia de las
// viejas "favoritas", acá TODA fila tiene una posición — no existe el
// concepto de "en la lista pero sin puesto", el orden es el punto central
// de un setlist. PK compuesta evita duplicar una canción en el mismo
// perfil; unique de (fanProfileId, position) evita dos canciones en el
// mismo puesto. Ver migration.sql para el CHECK de position 1-15.
model FanProfileSetlistSong {
  fanProfileId String
  songId       String
  position     Int
  createdAt    DateTime   @default(now())
  fanProfile   FanProfile @relation(fields: [fanProfileId], references: [id], onDelete: Cascade)
  song         Song       @relation(fields: [songId], references: [id])

  @@id([fanProfileId, songId])
  @@unique([fanProfileId, position])
  @@index([songId])
  @@map("fan_profile_setlist_songs")
}

// Top 10 de canciones favoritas de un fan — independiente del setlist de
// arriba (ver el comentario de FanProfileSetlistSong). Es también la
// fuente exclusiva de los rankings del Fan Map (mundial/país/ciudad, ver
// FanProfilesService#findFavoriteSongsRanking): el setlist personal nunca
// participa de esos rankings. Mismo criterio de position 1-10 siempre
// presente, CHECK en migration.sql.
model FanProfileFavoriteSong {
  fanProfileId String
  songId       String
  position     Int
  createdAt    DateTime   @default(now())
  fanProfile   FanProfile @relation(fields: [fanProfileId], references: [id], onDelete: Cascade)
  song         Song       @relation(fields: [songId], references: [id])

  @@id([fanProfileId, songId])
  @@unique([fanProfileId, position])
  @@index([songId])
  @@map("fan_profile_favorite_songs")
}
