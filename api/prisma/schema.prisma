// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Represents the system identity of a person using FanMap.
// Auth (login, password, OAuth, sessions) is not implemented yet.
// Today the only way a User is created is as a side effect of
// POST /fan-profiles (see FanProfilesService), which will be adapted
// to read the User from the authenticated request context once Auth exists.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fanProfile FanProfile?

  @@map("users")
}

// Minimal geographic catalog. Seeded manually for now (see prisma/seed.ts) —
// not exposed for writes by end users. Not artist-specific: this catalog is
// shared by every artist community FanMap supports.
model Country {
  id   String @id @default(uuid())
  name String
  code String @unique // ISO 3166-1 alpha-2

  cities City[]

  @@map("countries")
}

model City {
  id        String  @id @default(uuid())
  name      String
  countryId String
  latitude  Float?
  longitude Float?

  country     Country      @relation(fields: [countryId], references: [id])
  fanProfiles FanProfile[]

  @@unique([countryId, name])
  @@index([countryId])
  @@map("cities")
}

// A music artist a FanMap community can be built around. Today the system
// only has one seeded artist (The Warning, see prisma/seed.ts), but a
// FanProfile can follow any number of artists via FanArtist — the domain is
// not hardcoded to a single artist.
model Artist {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fans FanArtist[]

  @@map("artists")
}

// A user's public-facing fan data: display name, location, whether they opt
// in to appear on the fan map, and which artists they follow (see FanArtist).
model FanProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  cityId      String
  displayName String
  showOnMap   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  city    City        @relation(fields: [cityId], references: [id])
  artists FanArtist[]

  @@index([showOnMap])
  @@index([cityId])
  @@map("fan_profiles")
}

// Join entity for the FanProfile <-> Artist N:N relation (a fan follows N
// artists, an artist has N fans). Modeled explicitly (not an implicit m2n)
// so it can carry its own metadata, e.g. createdAt for "followed since".
model FanArtist {
  fanProfileId String
  artistId     String
  createdAt    DateTime @default(now())

  fanProfile FanProfile @relation(fields: [fanProfileId], references: [id])
  artist     Artist     @relation(fields: [artistId], references: [id])

  @@id([fanProfileId, artistId])
  @@index([artistId])
  @@map("fan_artists")
}
