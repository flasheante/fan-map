DATABASE_URL="postgresql://fan_map:fan_map@localhost:5432/fan_map?schema=public"

# setlist.fm API (https://api.setlist.fm/docs/1.0/) — required by
# `npm run sync:setlist-fm`. Get a key at https://www.setlist.fm/settings/apps
SETLIST_FM_API_KEY=

# Requests/second sent to setlist.fm (daily cap stays fixed at 1,440).
# Defaults to 2 if unset or invalid. Lower it (e.g. 0.5 = 1 request every 2s)
# for slower, gentler testing against the real API.
SETLIST_FM_REQUESTS_PER_SECOND=2

# MusicBrainz (https://musicbrainz.org/doc/MusicBrainz_API) — required by
# `npm run sync:musicbrainz`. No API key needed, but MusicBrainz asks every
# client to identify itself with a way to contact its maintainer in the
# User-Agent header (an email or a URL, e.g. a repo link) — requests without
# one risk being blocked. The sync still runs without this set, just with a
# generic, contact-less User-Agent.
MUSICBRAINZ_CONTACT=

# Requests/second sent to MusicBrainz. Defaults to 1 (MusicBrainz's published
# limit: never more than 1 request/second) if unset or invalid.
MUSICBRAINZ_REQUESTS_PER_SECOND=1

# Google OAuth (https://console.cloud.google.com/apis/credentials) — required
# by GET /auth/google and /auth/google/callback (see src/auth). Create an
# "OAuth client ID" (Web application) and set its authorized redirect URI to
# GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Signs the auth cookies (session + OAuth state, see src/auth) via
# cookie-parser. Required in production — set a long random value.
SESSION_SECRET=dev-insecure-session-secret

# How long a session lasts, in milliseconds. Defaults to 604800000 (7 days)
# if unset or invalid.
SESSION_MAX_AGE=604800000

# Forces the `secure` flag on auth cookies. Defaults to true when
# NODE_ENV=production, false otherwise (no local HTTPS). Set explicitly
# ("true"/"false") to override that default.
SESSION_SECURE=

# Where GET /auth/google/callback redirects to after a successful login.
WEB_APP_URL=http://localhost:3001
