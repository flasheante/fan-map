# URL base de la API NestJS (sin barra final).
# La API corre por defecto en el puerto 3000 (api/src/main.ts, sin PORT en api/.env).
#
# También es el destino del rewrite /api/:path* de next.config.ts, que es
# lo que usa lib/api.ts para todo lo que manda credentials:"include" (login,
# perfil, etc.) — ver el comentario de SESSION_API_URL ahí. El resto de las
# funciones (getArtists, getArtistShows...) le siguen pegando directo a esta
# URL, sin pasar por el proxy.
NEXT_PUBLIC_API_URL=http://localhost:3000
